{
  "name": "vaishnava-vani-desktop",
  "productName": "Vaishnava Vani",
  "version": "1.10.0",
  "description": "Vaishnava Vani — lectures of Maharajas and Prabhujis, verse by verse — Windows desktop build",
  "main": "main.js",
  "private": true,
  "license": "ISC",
  "author": "Vaishnava Vani",
  "scripts": {
    "export": "node scripts/export-web.js",
    "icons": "electron scripts/make-icons.js",
    "start": "electron .",
    "dev": "npm run export && electron .",
    "build": "npm run export",
    "dist": "npm run export && electron-builder --win",
    "dist:only": "electron-builder --win",
    "dist:dir": "npm run export && electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.maharajvani.desktop",
    "productName": "Vaishnava Vani",
    "copyright": "Audio courtesy of audio.iskcondesiretree.com",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "web/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vaishnava Vani",
      "artifactName": "VaishnavaVani-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VaishnavaVani-${version}-portable.${ext}"
    }
  }
}
