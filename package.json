{
  "name": "maharaj-vani",
  "version": "1.9.2",
  "description": "Vaishnava Vani — lectures of Radhanath Swami, Lokanath Swami, Bhakti Ashraya Vaishnava Swami, Gour Govinda Swami and five Prabhujis — verse by verse through BG, SB and CC, offline audio, search, YouTube",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "scrape": "node scripts/scrape-audio.js",
    "scrape:radhanath": "node scripts/scrape-audio.js --only radhanath",
    "scrape:lokanath": "node scripts/scrape-audio.js --only lokanath",
    "scrape:bhaktiashraya": "node scripts/scrape-audio.js --only bhaktiashraya",
    "scrape:gourgovinda": "node scripts/scrape-audio.js --only gourgovinda",
    "scrape:amarendra": "node scripts/scrape-audio.js --only amarendra",
    "scrape:radheshyam": "node scripts/scrape-audio.js --only radheshyam",
    "scrape:vidvangauranga": "node scripts/scrape-audio.js --only vidvangauranga",
    "scrape:vamsivadan": "node scripts/scrape-audio.js --only vamsivadan",
    "scrape:kartikeya": "node scripts/scrape-audio.js --only kartikeya",
    "crawl": "node scripts/crawl-site.js",
    "verses:table": "node scripts/build-verse-table.js",
    "verses:text": "node scripts/build-shastra.js",
    "verses:youtube": "node scripts/scrape-verse-youtube.js",
    "verses:others": "node scripts/build-verse-others.js",
    "verses:index": "node scripts/build-verse-index.js",
    "verses": "npm run verses:others && npm run verses:index",
    "stats": "node scripts/catalog-stats.js"
  },
  "license": "ISC",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.5",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-track-player": "^5.0.0-alpha0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.1.10",
    "typescript": "^5.9.3"
  }
}
